+impl State {
+    /// Super and scrolling, as in GNOME: down or right to the next
+    /// workspace, up or left to the previous; a notch of the wheel is one
+    /// switch, a touchpad's scroll is one until its fingers stop.
+    pub fn scroll_workspaces(&mut self, seat: &Seat<State>, steps: f64, touchpad: bool) {
+        if steps == 0. {
+            // the fingers lifted
+            self.common.workspace_scroll = Some(0.);
+            return;
+        }
+        let Some(scrolled) = self.common.workspace_scroll else {
+            return;
+        };
+        // Also tells cosmic-ext-gestures' install.sh this compositor is patched.
+        static NOTED: std::sync::Once = std::sync::Once::new();
+        NOTED.call_once(|| {
+            info!("Super and scrolling switch workspaces (io.github.DrakRosmann.CosmicGestures)")
+        });
+        // Back the other way: from there.
+        let scrolled = if scrolled * steps < 0. { steps } else { scrolled + steps };
+        if scrolled.abs() < 1. {
+            self.common.workspace_scroll = Some(scrolled);
+            return;
+        }
+        self.common.workspace_scroll = if touchpad {
+            None
+        } else {
+            Some(scrolled - scrolled.signum())
+        };
+        let wraparound = self.common.config.cosmic_conf.workspaces.workspace_wraparound;
+        let _ = if scrolled > 0. {
+            to_next_workspace(
+                &mut self.common.shell.write(),
+                seat,
+                false,
+                wraparound,
+                &mut self.common.workspace_state.update(),
+            )
+        } else {
+            to_previous_workspace(
+                &mut self.common.shell.write(),
+                seat,
+                false,
+                wraparound,
+                &mut self.common.workspace_state.update(),
+            )
+        };
+    }
+}
