+/// Check if a layer shell surface of this namespace is showing on the output.
+pub fn layer_is_open(output: &Output, namespace: &str) -> bool {
+    layer_map_for_output(output)
+        .layers()
+        .filter(|s| s.namespace() == namespace)
+        .any(|s| {
+            with_renderer_surface_state(s.wl_surface(), |state| state.buffer().is_some())
+                .unwrap_or(false)
+        })
+}
