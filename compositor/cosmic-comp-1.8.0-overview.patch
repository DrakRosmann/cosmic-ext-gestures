+thread_local! {
+    /// Frames of workspaces and windows that haven't changed since they were
+    /// last captured, waiting until they do.
+    static WAITING: RefCell<Vec<(SessionRef, Frame)>> = const { RefCell::new(Vec::new()) };
+    static RETRYING: Cell<bool> = const { Cell::new(false) };
+}
+
+/// How often waiting frames look for a change: as often as a screen updates.
+const RETRY_INTERVAL: Duration = Duration::from_micros(16_667);
+
+/// Holds `frame` of `session` until its source changes, looking again every
+/// frame. Copying a workspace or window as soon as it's asked, changed or not,
+/// had the overview redraw them all the time.
+fn wait_for_change(state: &mut State, session: SessionRef, frame: Frame) {
+    WAITING.with_borrow_mut(|waiting| waiting.push((session, frame)));
+    if RETRYING.replace(true) {
+        return;
+    }
+    let retry = state.common.event_loop_handle.insert_source(
+        Timer::from_duration(RETRY_INTERVAL),
+        |_, _, state| {
+            for (session, frame) in WAITING.take() {
+                // the client may have let go of the buffer meanwhile
+                if frame.has_failed() || !frame.buffer().is_alive() {
+                    continue;
+                }
+                state.frame(&session, frame);
+            }
+            if WAITING.with_borrow(Vec::is_empty) {
+                RETRYING.set(false);
+                TimeoutAction::Drop
+            } else {
+                TimeoutAction::ToDuration(RETRY_INTERVAL)
+            }
+        },
+    );
+    if let Err(err) = retry {
+        tracing::warn!(?err, "Failed to wait for a capture's source to change");
+        RETRYING.set(false);
+        WAITING.take();
+    }
+}
