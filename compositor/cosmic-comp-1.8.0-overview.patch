+/// What capturing a workspace or a window did.
+pub enum Captured {
+    /// Copied; ready once the GPU is done.
+    Copied(Option<PendingImageCopyData>),
+    /// Nothing changed since the last capture: the frame waits until something does.
+    Unchanged(Frame),
+}
+
+/// What a workspace or window capture rendered, if its source changed: the
+/// rendering, what changed and the buffers it read.
+type ChangedRender<'d> = Option<(
+    RenderOutputResult<'d>,
+    Vec<Rectangle<i32, Physical>>,
+    Vec<smithay::backend::renderer::utils::Buffer>,
+)>;
+
+/// Like [`render_session`], for workspaces and windows, which are copied when
+/// the client asks rather than as an output is drawn: it reports what changed
+/// in the source since the last capture (not what the client asked to have
+/// redrawn in its buffer too, which it then asks for again, and so on, every
+/// frame), and holds the frame while nothing did.
+pub fn render_changed<F, R>(
+    renderer: &mut R,
+    session: &SessionData,
+    frame: Frame,
+    transform: Transform,
+    render_fn: F,
+) -> Result<Captured, DTError<R::Error>>
+where
+    R: AsGlowRenderer,
+    F: for<'d> FnOnce(
+        &WlBuffer,
+        &mut R,
+        Option<&mut R::Framebuffer<'_>>,
+        &'d mut OutputDamageTracker,
+        &mut OutputDamageTracker,
+        usize,
+        Vec<Rectangle<i32, BufferCoords>>,
+    ) -> Result<ChangedRender<'d>, DTError<R::Error>>,
+{
+    let mut session_user_data = session.lock().unwrap();
+
+    // At most so often: they're shown small, and copying a busy window and its
+    // workspace every frame takes the GPU from what's being animated. And one at
+    // a time: several in the same frame made the screen miss it.
+    if session_user_data
+        .copied
+        .is_some_and(|copied| copied.elapsed() < MIN_COPY_INTERVAL)
+        || LAST_COPY.get().is_some_and(|last| last.elapsed() < MIN_COPY_SPACING)
+    {
+        return Ok(Captured::Unchanged(frame));
+    }
+
+    let buffer = frame.buffer();
+
+    let mut age = 1;
+    if matches!(buffer_type(&buffer), Some(BufferType::Shm)) {
+        let size = buffer_dimensions(&buffer).ok_or(DTError::OutputNoMode(OutputNoMode))?;
+        let format = with_buffer_contents(&buffer, |_, _, data| {
+            shm_format_to_fourcc(data.format)
+                .expect("We should be able to convert all hardcoded shm screencopy formats")
+        })
+        .map_err(|_| DTError::OutputNoMode(OutputNoMode))?;
+
+        session_user_data
+            .offscreen
+            .take_if(|(context_id, renderbuffer)| {
+                renderer.glow_renderer().context_id() != *context_id
+                    || renderbuffer.size() != size
+                    || renderbuffer.format() != Some(format)
+            });
+
+        if session_user_data.offscreen.is_none() {
+            let renderbuffer = Offscreen::<GlesRenderbuffer>::create_buffer(renderer, format, size)
+                .map_err(DTError::Rendering)?;
+            session_user_data.offscreen =
+                Some((renderer.glow_renderer().context_id(), renderbuffer));
+            age = 0;
+        }
+    } else {
+        session_user_data.offscreen = None;
+    }
+
+    let SessionUserData {
+        dt,
+        content,
+        copied,
+        offscreen,
+    } = &mut *session_user_data;
+    let mut fb = offscreen
+        .as_mut()
+        .map(|(_, tex)| renderer.bind(tex).map_err(DTError::Rendering))
+        .transpose()?;
+    let Some((result, changed, buffers)) = render_fn(
+        &frame.buffer(),
+        renderer,
+        fb.as_mut(),
+        dt,
+        content,
+        age,
+        frame.damage(),
+    )?
+    else {
+        return Ok(Captured::Unchanged(frame));
+    };
+    *copied = Some(Instant::now());
+    LAST_COPY.set(*copied);
+
+    submit_buffer(
+        frame,
+        renderer,
+        fb.as_mut(),
+        transform,
+        Some(&changed),
+        result.sync,
+        buffers,
+    )
+    .map(Captured::Copied)
+    .map_err(DTError::Rendering)
+}
+
+/// How often a workspace or window is copied at most: 30 times a second (the
+/// frames that wait are looked at again every 1/60 s).
+const MIN_COPY_INTERVAL: Duration = Duration::from_millis(30);
+/// Between any two copies: one per look, every 1/60 s.
+const MIN_COPY_SPACING: Duration = Duration::from_millis(12);
+
+thread_local! {
+    static LAST_COPY: std::cell::Cell<Option<Instant>> = const { std::cell::Cell::new(None) };
+}
+
+/// What changed in `elements` since the last capture, if anything.
+fn changed<E: smithay::backend::renderer::element::Element>(
+    content: &mut OutputDamageTracker,
+    elements: &[E],
+) -> Result<Option<Vec<Rectangle<i32, Physical>>>, OutputNoMode> {
+    Ok(content
+        .damage_output(1, elements)?
+        .0
+        .filter(|damage| !damage.is_empty())
+        .cloned())
+}
