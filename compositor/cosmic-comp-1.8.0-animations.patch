+
+/// Clutter's `EASE_OUT_EXPO`, which GNOME opens and minimizes windows with.
+#[derive(Copy, Clone, Debug, Default)]
+pub struct EaseOutExpo;
+
+impl keyframe::EasingFunction for EaseOutExpo {
+    fn y(&self, x: f64) -> f64 {
+        if x >= 1.0 {
+            1.0
+        } else {
+            1.0 - 2f64.powf(-10.0 * x)
+        }
+    }
+}
