new file mode 100644
index 0000000..b578893
--- /dev/null
+++ b/src/shell/close_animation.rs
@@ -0,0 +1,209 @@
+//! Closing windows shrink a little and fade out, like GNOME's. The client
+//! takes the window's contents with it, so what it last showed is kept as a
+//! picture, read back from the GPU right before the window goes.
+
+use std::time::{Duration, Instant};
+
+use anyhow::Context;
+use keyframe::{EasingFunction, functions::EaseOutQuad};
+use smithay::{
+    backend::{
+        allocator::Fourcc,
+        renderer::{
+            Offscreen,
+            damage::OutputDamageTracker,
+            element::{
+                Kind, RenderElement,
+                memory::{MemoryRenderBuffer, MemoryRenderBufferRenderElement},
+            },
+            gles::GlesRenderbuffer,
+        },
+    },
+    desktop::space::SpaceElement,
+    reexports::wayland_server::protocol::wl_surface::WlSurface,
+    utils::{Logical, Physical, Point, Rectangle, Scale, Size, Transform},
+};
+use tracing::warn;
+
+use crate::{
+    backend::render::{RendererRef, element::AsGlowRenderer},
+    shell::element::{CosmicMapped, CosmicMappedRenderElement},
+    state::{State, advertised_node_for_surface},
+    utils::{iced::IcedRenderElement, prelude::*},
+    wayland::protocols::workspace::WorkspaceHandle,
+};
+
+// GNOME's: 150 ms, down to 80% of the size.
+pub const CLOSE_ANIMATION_DURATION: Duration = Duration::from_millis(150);
+const CLOSE_SCALE: f64 = 0.8;
+
+#[derive(Debug)]
+pub struct ClosingWindow {
+    buffer: MemoryRenderBuffer,
+    /// Where the picture was in the workspace: the window and what its client
+    /// draws around it, like shadows.
+    area: Rectangle<i32, Logical>,
+    /// The picture's size in pixels.
+    pixels: Size<i32, Logical>,
+    start: Instant,
+}
+
+impl ClosingWindow {
+    /// A picture of `mapped`, whose window is at `geometry` in its workspace,
+    /// at the output's `scale`.
+    fn new<R>(
+        renderer: &mut R,
+        mapped: &CosmicMapped,
+        geometry: Rectangle<i32, Local>,
+        scale: f64,
+    ) -> anyhow::Result<Self>
+    where
+        R: AsGlowRenderer,
+        R::TextureId: Send + Clone + 'static,
+        R::Error: Send + Sync + 'static,
+        CosmicMappedRenderElement<R>: RenderElement<R>,
+    {
+        let bbox = SpaceElement::bbox(mapped);
+        let area = Rectangle::new(
+            geometry.loc.as_logical() - mapped.geometry().loc + bbox.loc,
+            bbox.size,
+        );
+        let size = bbox.size.to_physical_precise_round(scale);
+        anyhow::ensure!(size.w > 0 && size.h > 0, "nothing to picture");
+
+        let origin: Point<i32, Physical> = bbox.loc.to_physical_precise_round(scale);
+        let mut elements = Vec::new();
+        let mut below = Vec::new();
+        mapped.push_render_elements(
+            renderer,
+            Point::from((-origin.x, -origin.y)),
+            None,
+            Scale::from(scale),
+            1.0,
+            None,
+            None,
+            &mut |elem| elements.push(elem),
+            &mut |elem| below.push(elem),
+        );
+        elements.extend(below);
+
+        let format = Fourcc::Abgr8888;
+        let buffer_size = size.to_logical(1).to_buffer(1, Transform::Normal);
+        let mut render_buffer =
+            Offscreen::<GlesRenderbuffer>::create_buffer(renderer, format, buffer_size)?;
+        let mut fb = renderer.bind(&mut render_buffer)?;
+        let mut damage_tracker = OutputDamageTracker::new(size, 1.0, Transform::Normal);
+        damage_tracker
+            .render_output(renderer, &mut fb, 0, &elements, [0.0, 0.0, 0.0, 0.0])
+            .map_err(|err| match err {
+                smithay::backend::renderer::damage::Error::Rendering(err) => err,
+                smithay::backend::renderer::damage::Error::OutputNoMode(_) => unreachable!(),
+            })?;
+        let mapping =
+            renderer.copy_framebuffer(&fb, Rectangle::from_size(buffer_size), format)?;
+        let pixels = renderer.map_texture(&mapping)?;
+        let buffer =
+            MemoryRenderBuffer::from_slice(pixels, format, buffer_size, 1, Transform::Normal, None);
+
+        Ok(ClosingWindow {
+            buffer,
+            area,
+            pixels: size.to_logical(1),
+            start: Instant::now(),
+        })
+    }
+
+    pub fn is_animating(&self) -> bool {
+        Instant::now().duration_since(self.start) < CLOSE_ANIMATION_DURATION
+    }
+
+    pub fn render_element<R>(
+        &self,
+        renderer: &mut R,
+        output_scale: f64,
+        alpha: f32,
+    ) -> Option<CosmicMappedRenderElement<R>>
+    where
+        R: AsGlowRenderer,
+        R::TextureId: Send + Clone + 'static,
+        CosmicMappedRenderElement<R>: RenderElement<R>,
+    {
+        let linear = (Instant::now().duration_since(self.start).as_secs_f64()
+            / CLOSE_ANIMATION_DURATION.as_secs_f64())
+        .min(1.0);
+        let progress = EaseOutQuad.y(linear);
+        let scale = 1.0 - (1.0 - CLOSE_SCALE) * progress;
+
+        // Shrinks toward its middle.
+        let size = self.area.size.to_f64().upscale(scale);
+        let loc = self.area.loc.to_f64()
+            + Point::from((
+                (self.area.size.w as f64 - size.w) / 2.0,
+                (self.area.size.h as f64 - size.h) / 2.0,
+            ));
+
+        let elem = MemoryRenderBufferRenderElement::from_buffer(
+            renderer,
+            loc.to_physical(output_scale),
+            &self.buffer,
+            Some(alpha * (1.0 - progress) as f32),
+            // all of it, scaled to `size`
+            Some(Rectangle::from_size(self.pixels.to_f64())),
+            Some(size.to_i32_round()),
+            Kind::Unspecified,
+        )
+        .ok()?;
+        Some(IcedRenderElement::UI(elem).into())
+    }
+}
+
+/// Keeps a picture of the window `surface` is, to fade out once it's gone.
+/// For a shown window alone in its element (in a stack, another one takes
+/// its place); called right before unmapping it.
+pub fn picture_closing_window(state: &mut State, surface: &WlSurface) {
+    let found: Option<(WorkspaceHandle, CosmicMapped, Rectangle<i32, Local>, f64)> = {
+        let shell = state.common.shell.read();
+        shell.workspaces.spaces().find_map(|workspace| {
+            let mapped = workspace
+                .floating_layer
+                .mapped()
+                .chain(workspace.tiling_layer.mapped().map(|(m, _)| m))
+                .find(|m| m.windows().any(|(w, _)| &w == surface))?;
+            if mapped.windows().count() > 1
+                || shell.active_space(&workspace.output)?.handle != workspace.handle
+            {
+                return None;
+            }
+            let geometry = workspace.element_geometry(mapped)?;
+            let scale = workspace.output.current_scale().fractional_scale();
+            Some((workspace.handle, mapped.clone(), geometry, scale))
+        })
+    };
+    let Some((handle, mapped, geometry, scale)) = found else {
+        return;
+    };
+
+    let dh = state.common.display_handle.clone();
+    let closing = state
+        .backend
+        .offscreen_renderer(|kms| {
+            advertised_node_for_surface(surface, &dh).or(*kms.primary_node.read().unwrap())
+        })
+        .context("No renderer to picture the closing window")
+        .and_then(|renderer| match renderer {
+            RendererRef::Glow(renderer) => ClosingWindow::new(renderer, &mapped, geometry, scale),
+            RendererRef::GlMulti(mut renderer) => {
+                ClosingWindow::new(&mut renderer, &mapped, geometry, scale)
+            }
+        });
+
+    match closing {
+        Ok(closing) => {
+            let mut shell = state.common.shell.write();
+            if let Some(workspace) = shell.workspaces.space_for_handle_mut(&handle) {
+                workspace.closing_windows.push(closing);
+            }
+        }
+        Err(err) => warn!(?err, "Failed to picture the closing window"),
+    }
+}
