diff --git a/src/shell/layer_animation.rs b/src/shell/layer_animation.rs
new file mode 100644
index 0000000..d02309e
--- /dev/null
+++ b/src/shell/layer_animation.rs
@@ -0,0 +1,520 @@
+//! The shell's layer surfaces open and close like GNOME's: the app library
+//! and the launcher fade in growing into place, the workspaces overview fades
+//! in settling from a little bigger while the windows fade out under it, and
+//! the panel's popups do the same, faster. They close the other way. The
+//! client takes the surface with it, so what it last showed is kept as a
+//! picture, read back from the GPU right before it goes, as for windows.
+
+use std::{
+    sync::{Mutex, OnceLock},
+    time::{Duration, Instant},
+};
+
+use anyhow::Context;
+use keyframe::{EasingFunction, functions::EaseOutQuad};
+use smithay::{
+    backend::{
+        allocator::Fourcc,
+        renderer::{
+            Offscreen,
+            damage::OutputDamageTracker,
+            element::{
+                Kind, RenderElement,
+                memory::{MemoryRenderBuffer, MemoryRenderBufferRenderElement},
+            },
+            gles::GlesRenderbuffer,
+            utils::with_renderer_surface_state,
+        },
+    },
+    desktop::{LayerSurface, PopupManager, layer_map_for_output},
+    output::Output,
+    reexports::wayland_server::protocol::wl_surface::WlSurface,
+    utils::{Logical, Point, Rectangle, Scale, Size, Transform},
+    wayland::compositor::with_states,
+};
+use tracing::warn;
+
+use crate::{
+    backend::render::{
+        RendererRef,
+        element::AsGlowRenderer,
+        wayland::{SurfaceRenderElement, push_render_elements_from_surface_tree},
+    },
+    state::{State, advertised_node_for_surface},
+    utils::quirks::{APP_LIBRARY_NAMESPACE, LAUNCHER_NAMESPACE, WORKSPACE_OVERVIEW_NAMESPACE},
+    wayland::handlers::{
+        compositor::FRAME_TIME_FILTER,
+        corner_radius::{pad_rect, surface_corners, surface_padding},
+    },
+};
+
+/// What a surface does opening and closing.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Animation {
+    open: Duration,
+    close: Duration,
+    /// The size it opens from and closes to.
+    scale: f64,
+    /// Where it grows from, as a fraction of what it shows.
+    origin: (f64, f64),
+}
+
+// GNOME's overview: 250 ms, easing out.
+const OVERVIEW: Animation = Animation {
+    open: Duration::from_millis(250),
+    close: Duration::from_millis(250),
+    scale: 1.05,
+    origin: (0.5, 0.5),
+};
+const APP_LIBRARY: Animation = Animation {
+    open: Duration::from_millis(250),
+    close: Duration::from_millis(200),
+    scale: 0.9,
+    origin: (0.5, 0.5),
+};
+// From the top, where it is.
+const LAUNCHER: Animation = Animation {
+    open: Duration::from_millis(200),
+    close: Duration::from_millis(150),
+    scale: 0.9,
+    origin: (0.5, 0.0),
+};
+// GNOME's menus: 150 ms. Grows out of the panel's side; set when drawn.
+const POPUP: Animation = Animation {
+    open: Duration::from_millis(150),
+    close: Duration::from_millis(150),
+    scale: 0.9,
+    origin: (0.5, 0.0),
+};
+
+/// Margin kept around what a layer shows when picturing it, for its shadow.
+const PICTURE_MARGIN: i32 = 48;
+
+fn for_namespace(namespace: &str) -> Option<Animation> {
+    match namespace {
+        WORKSPACE_OVERVIEW_NAMESPACE => Some(OVERVIEW),
+        APP_LIBRARY_NAMESPACE => Some(APP_LIBRARY),
+        LAUNCHER_NAMESPACE => Some(LAUNCHER),
+        _ => None,
+    }
+}
+
+struct Opening {
+    animation: Animation,
+    /// From its first frame with something to show.
+    start: OnceLock<Instant>,
+}
+
+fn mark(surface: &WlSurface, animation: Animation) {
+    with_states(surface, |states| {
+        states.data_map.insert_if_missing_threadsafe(|| Opening {
+            animation,
+            start: OnceLock::new(),
+        });
+    });
+}
+
+/// Called as a layer surface maps.
+pub fn layer_mapped(layer: &LayerSurface) {
+    if let Some(animation) = for_namespace(layer.namespace()) {
+        mark(layer.wl_surface(), animation);
+    }
+}
+
+/// Called as a popup of a layer surface is made.
+pub fn popup_created(surface: &WlSurface) {
+    mark(surface, POPUP);
+}
+
+/// How far opening `surface` is, eased, if it is. Its clock starts once it
+/// has something to show.
+fn opening_progress(surface: &WlSurface) -> Option<(Animation, f64)> {
+    let has_buffer =
+        with_renderer_surface_state(surface, |state| state.buffer().is_some()).unwrap_or(false);
+    with_states(surface, |states| {
+        let opening = states.data_map.get::<Opening>()?;
+        let start = if has_buffer {
+            *opening.start.get_or_init(Instant::now)
+        } else {
+            *opening.start.get()?
+        };
+        let linear = Instant::now().duration_since(start).as_secs_f64()
+            / opening.animation.open.as_secs_f64();
+        (linear < 1.0).then(|| (opening.animation, EaseOutQuad.y(linear)))
+    })
+}
+
+/// For drawing `surface`, whose visible part is `area`: its alpha, and the
+/// scale to draw it at around a point, while it opens.
+pub fn opening(
+    surface: &WlSurface,
+    area: Rectangle<f64, Logical>,
+    from_above: bool,
+) -> Option<(f32, f64, Point<f64, Logical>)> {
+    let (mut animation, progress) = opening_progress(surface)?;
+    if animation == POPUP && !from_above {
+        animation.origin.1 = 1.0;
+    }
+    let scale = animation.scale + (1.0 - animation.scale) * progress;
+    Some((progress as f32, scale, origin(&animation, area)))
+}
+
+fn origin(animation: &Animation, area: Rectangle<f64, Logical>) -> Point<f64, Logical> {
+    area.loc + Point::from((area.size.w * animation.origin.0, area.size.h * animation.origin.1))
+}
+
+fn overview_layers(output: &Output) -> Vec<LayerSurface> {
+    layer_map_for_output(output)
+        .layers()
+        .filter(|s| s.namespace() == WORKSPACE_OVERVIEW_NAMESPACE)
+        .cloned()
+        .collect()
+}
+
+/// Whether the overview is still opening on `output`: the windows are drawn,
+/// fading out, until it's done.
+pub fn overview_opening(output: &Output) -> bool {
+    overview_layers(output)
+        .iter()
+        .any(|layer| opening_progress(layer.wl_surface()).is_some())
+}
+
+/// The windows fade out as the overview opens, and back in as it closes.
+pub fn windows_alpha(output: &Output) -> f32 {
+    let opening = overview_layers(output)
+        .iter()
+        .filter_map(|layer| opening_progress(layer.wl_surface()))
+        .map(|(_, progress)| 1.0 - progress as f32)
+        .reduce(f32::min);
+    if let Some(alpha) = opening {
+        return alpha;
+    }
+    closing_layers(output)
+        .lock()
+        .unwrap()
+        .iter()
+        .filter(|closing| closing.animation == OVERVIEW)
+        .map(|closing| closing.progress() as f32)
+        .reduce(f32::min)
+        .unwrap_or(1.0)
+}
+
+/// Whether anything opens or closes on `output`.
+pub fn animating(output: &Output) -> bool {
+    if !closing_layers(output).lock().unwrap().is_empty() {
+        return true;
+    }
+    let layers = layer_map_for_output(output)
+        .layers()
+        .cloned()
+        .collect::<Vec<_>>();
+    layers.iter().any(|layer| {
+        opening_progress(layer.wl_surface()).is_some()
+            || PopupManager::popups_for_surface(layer.wl_surface())
+                .any(|(popup, _)| opening_progress(popup.wl_surface()).is_some())
+    })
+}
+
+/// Drops what's done closing; whether anything was.
+pub fn update(output: &Output) -> bool {
+    let mut closing = closing_layers(output).lock().unwrap();
+    let before = closing.len();
+    closing.retain(|closing| closing.progress() < 1.0);
+    closing.len() != before
+}
+
+#[derive(Default)]
+struct ClosingLayers(Mutex<Vec<ClosingLayer>>);
+
+fn closing_layers(output: &Output) -> &Mutex<Vec<ClosingLayer>> {
+    &output
+        .user_data()
+        .get_or_insert_threadsafe(ClosingLayers::default)
+        .0
+}
+
+#[derive(Debug)]
+pub struct ClosingLayer {
+    buffer: MemoryRenderBuffer,
+    /// Where the picture was on the output.
+    area: Rectangle<i32, Logical>,
+    /// The picture's size in pixels.
+    pixels: Size<i32, Logical>,
+    animation: Animation,
+    origin: Point<f64, Logical>,
+    start: Instant,
+}
+
+impl ClosingLayer {
+    fn progress(&self) -> f64 {
+        (Instant::now().duration_since(self.start).as_secs_f64()
+            / self.animation.close.as_secs_f64())
+        .min(1.0)
+    }
+
+    fn render_element<R>(
+        &self,
+        renderer: &mut R,
+        output_scale: f64,
+    ) -> Option<MemoryRenderBufferRenderElement<R>>
+    where
+        R: AsGlowRenderer,
+        R::TextureId: Send + Clone + 'static,
+    {
+        let progress = EaseOutQuad.y(self.progress());
+        let scale = 1.0 + (self.animation.scale - 1.0) * progress;
+        let area = self.area.to_f64();
+        let size = area.size.upscale(scale);
+        let loc = self.origin + (area.loc - self.origin).upscale(scale);
+
+        MemoryRenderBufferRenderElement::from_buffer(
+            renderer,
+            loc.to_physical(output_scale),
+            &self.buffer,
+            Some((1.0 - progress) as f32),
+            Some(Rectangle::from_size(self.pixels.to_f64())),
+            Some(size.to_i32_round()),
+            Kind::Unspecified,
+        )
+        .ok()
+    }
+}
+
+/// The closing surfaces on `output`, topmost first.
+pub fn closing_elements<R>(
+    renderer: &mut R,
+    output: &Output,
+) -> Vec<MemoryRenderBufferRenderElement<R>>
+where
+    R: AsGlowRenderer,
+    R::TextureId: Send + Clone + 'static,
+{
+    let scale = output.current_scale().fractional_scale();
+    closing_layers(output)
+        .lock()
+        .unwrap()
+        .iter()
+        .rev()
+        .filter_map(|closing| closing.render_element(renderer, scale))
+        .collect()
+}
+
+/// A picture of the surface tree of `surface`, whose origin is at `loc` and
+/// whose geometry is `geometry`, of `area` (all on the output) at `scale`.
+fn picture<R>(
+    renderer: &mut R,
+    surface: &WlSurface,
+    loc: Point<i32, Logical>,
+    geometry: Rectangle<i32, Logical>,
+    area: Rectangle<i32, Logical>,
+    scale: f64,
+) -> anyhow::Result<(MemoryRenderBuffer, Size<i32, Logical>)>
+where
+    R: AsGlowRenderer,
+    R::TextureId: Send + Clone + 'static,
+    R::Error: Send + Sync + 'static,
+    SurfaceRenderElement<R>: RenderElement<R>,
+{
+    let size = area.size.to_physical_precise_round(scale);
+    anyhow::ensure!(size.w > 0 && size.h > 0, "nothing to picture");
+
+    let radii = with_states(surface, |states| surface_corners(states, geometry.size))
+        .unwrap_or([0; 4]);
+    let mut elements = Vec::new();
+    push_render_elements_from_surface_tree(
+        renderer,
+        surface,
+        (loc - area.loc).to_physical_precise_round(scale),
+        Rectangle::new(geometry.loc - area.loc, geometry.size).to_f64(),
+        Scale::from(scale),
+        1.0,
+        false,
+        radii,
+        None,
+        0,
+        FRAME_TIME_FILTER,
+        &mut |elem| elements.push(elem),
+        None,
+    );
+    anyhow::ensure!(!elements.is_empty(), "nothing to picture");
+
+    let format = Fourcc::Abgr8888;
+    let buffer_size = size.to_logical(1).to_buffer(1, Transform::Normal);
+    let mut render_buffer =
+        Offscreen::<GlesRenderbuffer>::create_buffer(renderer, format, buffer_size)?;
+    let mut fb = renderer.bind(&mut render_buffer)?;
+    let mut damage_tracker = OutputDamageTracker::new(size, 1.0, Transform::Normal);
+    damage_tracker
+        .render_output(renderer, &mut fb, 0, &elements, [0.0, 0.0, 0.0, 0.0])
+        .map_err(|err| match err {
+            smithay::backend::renderer::damage::Error::Rendering(err) => err,
+            smithay::backend::renderer::damage::Error::OutputNoMode(_) => unreachable!(),
+        })?;
+    let mapping = renderer.copy_framebuffer(&fb, Rectangle::from_size(buffer_size), format)?;
+    let pixels = renderer.map_texture(&mapping)?;
+    let buffer =
+        MemoryRenderBuffer::from_slice(pixels, format, buffer_size, 1, Transform::Normal, None);
+    Ok((buffer, size.to_logical(1)))
+}
+
+struct Target {
+    surface: WlSurface,
+    output: Output,
+    loc: Point<i32, Logical>,
+    geometry: Rectangle<i32, Logical>,
+    area: Rectangle<i32, Logical>,
+    animation: Animation,
+    origin: Point<f64, Logical>,
+}
+
+fn keep_picture(state: &mut State, target: Target) {
+    let scale = target.output.current_scale().fractional_scale();
+    let dh = state.common.display_handle.clone();
+    let picture = state
+        .backend
+        .offscreen_renderer(|kms| {
+            advertised_node_for_surface(&target.surface, &dh)
+                .or(*kms.primary_node.read().unwrap())
+        })
+        .context("No renderer to picture the closing surface")
+        .and_then(|renderer| match renderer {
+            RendererRef::Glow(renderer) => picture(
+                renderer,
+                &target.surface,
+                target.loc,
+                target.geometry,
+                target.area,
+                scale,
+            ),
+            RendererRef::GlMulti(mut renderer) => picture(
+                &mut renderer,
+                &target.surface,
+                target.loc,
+                target.geometry,
+                target.area,
+                scale,
+            ),
+        });
+
+    match picture {
+        Ok((buffer, pixels)) => {
+            closing_layers(&target.output)
+                .lock()
+                .unwrap()
+                .push(ClosingLayer {
+                    buffer,
+                    area: target.area,
+                    pixels,
+                    animation: target.animation,
+                    origin: target.origin,
+                    start: Instant::now(),
+                });
+            state.backend.schedule_render(&target.output);
+        }
+        Err(err) => warn!(?err, "Failed to picture the closing surface"),
+    }
+}
+
+/// Keeps a picture of `layer` on `output` to close, if it animates; called
+/// right before unmapping it.
+pub fn picture_closing_layer(state: &mut State, output: &Output, layer: &LayerSurface) {
+    let Some(animation) = for_namespace(layer.namespace()) else {
+        return;
+    };
+    // Only one that was showing.
+    if !with_renderer_surface_state(layer.wl_surface(), |state| state.buffer().is_some())
+        .unwrap_or(false)
+    {
+        return;
+    }
+    let Some(layer_geometry) = layer_map_for_output(output).layer_geometry(layer) else {
+        return;
+    };
+    let loc = layer_geometry.loc;
+    let mut geometry = layer.geometry();
+    geometry.loc += loc;
+    let shown = with_states(layer.wl_surface(), |states| {
+        surface_padding(states).and_then(|padding| pad_rect(geometry, &padding))
+    })
+    .unwrap_or(geometry);
+    let area = if shown == geometry {
+        geometry
+    } else {
+        let mut area = shown;
+        area.loc -= Point::from((PICTURE_MARGIN, PICTURE_MARGIN));
+        area.size += Size::from((PICTURE_MARGIN * 2, PICTURE_MARGIN * 2));
+        area.intersection(geometry).unwrap_or(shown)
+    };
+
+    keep_picture(
+        state,
+        Target {
+            surface: layer.wl_surface().clone(),
+            output: output.clone(),
+            loc,
+            geometry,
+            area,
+            animation,
+            origin: origin(&animation, shown.to_f64()),
+        },
+    );
+}
+
+/// Keeps a picture of the popup `surface` to close, if it's of a layer
+/// surface; called as it's destroyed.
+pub fn picture_closing_popup(state: &mut State, surface: &WlSurface) {
+    let found = {
+        let shell = state.common.shell.read();
+        shell.outputs().find_map(|output| {
+            let map = layer_map_for_output(output);
+            map.layers().find_map(|layer| {
+                let layer_geometry = map.layer_geometry(layer)?;
+                PopupManager::popups_for_surface(layer.wl_surface()).find_map(
+                    |(popup, offset)| {
+                        (popup.wl_surface() == surface).then(|| {
+                            let loc = layer_geometry.loc + offset - popup.geometry().loc;
+                            let mut geometry = popup.geometry();
+                            geometry.loc += loc;
+                            let below = geometry.loc.y as f64 + geometry.size.h as f64 / 2.0
+                                >= layer_geometry.loc.y as f64
+                                    + layer_geometry.size.h as f64 / 2.0;
+                            (output.clone(), loc, geometry, below)
+                        })
+                    },
+                )
+            })
+        })
+    };
+    let Some((output, loc, geometry, below)) = found else {
+        return;
+    };
+    if !with_renderer_surface_state(surface, |state| state.buffer().is_some()).unwrap_or(false) {
+        return;
+    }
+    let mut animation = POPUP;
+    if !below {
+        animation.origin.1 = 1.0;
+    }
+    keep_picture(
+        state,
+        Target {
+            surface: surface.clone(),
+            output,
+            loc,
+            geometry,
+            area: geometry,
+            animation,
+            origin: origin(&animation, geometry.to_f64()),
+        },
+    );
+}
+
+/// Whether the popup at `geometry` is below the layer surface it's of, on
+/// `output`: it grows down from it then, else up.
+pub fn popup_below(output: &Output, layer: &LayerSurface, geometry: Rectangle<i32, Logical>) -> bool {
+    let Some(layer_geometry) = layer_map_for_output(output).layer_geometry(layer) else {
+        return true;
+    };
+    geometry.loc.y as f64 + geometry.size.h as f64 / 2.0
+        >= layer_geometry.loc.y as f64 + layer_geometry.size.h as f64 / 2.0
+}
