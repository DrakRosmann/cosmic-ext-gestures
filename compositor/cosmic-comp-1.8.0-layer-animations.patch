--- /dev/null
+++ b/src/shell/layer_animation.rs
@@ -0,0 +1,830 @@
+//! The shell's layer surfaces open and close like GNOME's: the app library
+//! and the launcher fade in growing into place, the workspaces overview fades
+//! in settling from a little bigger while the windows fade out under it, and
+//! the panel's popups do the same, faster. They close the other way. The
+//! client takes the surface with it, so what it last showed is kept as a
+//! picture, read back from the GPU right before it goes, as for windows.
+
+use std::{
+    sync::Mutex,
+    time::{Duration, Instant},
+};
+
+use anyhow::Context;
+use keyframe::{EasingFunction, functions::EaseOutQuad};
+use smithay::{
+    backend::{
+        allocator::{Fourcc, dmabuf::Dmabuf},
+        renderer::{
+            ImportDma, Offscreen, Texture,
+            damage::OutputDamageTracker,
+            element::{
+                Id, Kind, RenderElement,
+                memory::{MemoryRenderBuffer, MemoryRenderBufferRenderElement},
+                texture::TextureRenderElement,
+            },
+            gles::GlesRenderbuffer,
+            utils::{CommitCounter, with_renderer_surface_state},
+        },
+    },
+    desktop::{LayerSurface, PopupManager, layer_map_for_output},
+    output::Output,
+    reexports::wayland_server::protocol::wl_surface::WlSurface,
+    utils::{Logical, Point, Rectangle, Scale, Size, Transform},
+    wayland::{
+        compositor::{
+            BufferAssignment, SurfaceAttributes, add_pre_commit_hook, get_children, with_states,
+        },
+        dmabuf::get_dmabuf,
+    },
+};
+use tracing::warn;
+
+use crate::{
+    backend::render::{
+        RendererRef,
+        element::AsGlowRenderer,
+        wayland::{
+            SurfaceRenderElement,
+            blur_effect::{BlurElement, BlurState},
+            push_render_elements_from_surface_tree,
+        },
+    },
+    shell::{CosmicMappedRenderElement, WorkspaceRenderElement},
+    state::{State, advertised_node_for_surface},
+    utils::{
+        iced::IcedRenderElement,
+        quirks::{APP_LIBRARY_NAMESPACE, LAUNCHER_NAMESPACE, WORKSPACE_OVERVIEW_NAMESPACE},
+    },
+    wayland::handlers::{
+        background_effect::ComputedBlurRegionCachedState,
+        compositor::FRAME_TIME_FILTER,
+        corner_radius::{pad_rect, surface_corners, surface_padding},
+    },
+};
+
+/// What a surface does opening and closing.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Animation {
+    open: Duration,
+    close: Duration,
+    /// The size it opens from and closes to.
+    scale: f64,
+    /// Where it grows from, as a fraction of what it shows.
+    origin: (f64, f64),
+}
+
+// GNOME's overview: 250 ms, easing out.
+const OVERVIEW: Animation = Animation {
+    open: Duration::from_millis(250),
+    close: Duration::from_millis(250),
+    scale: 1.05,
+    origin: (0.5, 0.5),
+};
+const APP_LIBRARY: Animation = Animation {
+    open: Duration::from_millis(250),
+    close: Duration::from_millis(200),
+    scale: 0.9,
+    origin: (0.5, 0.5),
+};
+// From the top, where it is.
+const LAUNCHER: Animation = Animation {
+    open: Duration::from_millis(200),
+    close: Duration::from_millis(150),
+    scale: 0.9,
+    origin: (0.5, 0.0),
+};
+// GNOME's menus: 150 ms. Grows out of the panel's side; set when drawn.
+const POPUP: Animation = Animation {
+    open: Duration::from_millis(150),
+    close: Duration::from_millis(150),
+    scale: 0.9,
+    origin: (0.5, 0.0),
+};
+
+/// Margin kept around what a layer shows when picturing it, for its shadow.
+const PICTURE_MARGIN: i32 = 48;
+
+fn for_namespace(namespace: &str) -> Option<Animation> {
+    match namespace {
+        WORKSPACE_OVERVIEW_NAMESPACE => Some(OVERVIEW),
+        APP_LIBRARY_NAMESPACE => Some(APP_LIBRARY),
+        LAUNCHER_NAMESPACE => Some(LAUNCHER),
+        _ => None,
+    }
+}
+
+struct Opening {
+    animation: Animation,
+    clock: Mutex<Clock>,
+}
+
+/// When a surface begins opening. The shell's clients (libcosmic) first show
+/// an empty frame, and what they have to show a frame or two later: it begins
+/// with the second frame, or a little after the first if none comes, and is
+/// hidden until then.
+#[derive(Default)]
+struct Clock {
+    /// The first frame, and when it was first drawn.
+    first: Option<(CommitCounter, Instant)>,
+    start: Option<Instant>,
+}
+
+/// How long to wait for the second frame.
+const SECOND_FRAME_WAIT: Duration = Duration::from_millis(50);
+
+fn mark(surface: &WlSurface, animation: Animation) {
+    let new = with_states(surface, |states| {
+        states.data_map.insert_if_missing_threadsafe(|| Opening {
+            animation,
+            clock: Mutex::default(),
+        })
+    });
+    if new {
+        add_pre_commit_hook::<State, _>(surface, |_, _, surface| keep_shown(surface));
+    }
+}
+
+/// What a surface showed before its latest frame. COSMIC's shell clients take
+/// down their blur and rounded corners and draw one last frame as they close
+/// (the app library's, emptied), which the screen never really shows: such a
+/// surface closes as it was before it.
+pub struct Shown {
+    dmabuf: Dmabuf,
+    src: Rectangle<f64, Logical>,
+    dst: Size<i32, Logical>,
+    offset: Point<i32, Logical>,
+    buffer_scale: i32,
+    transform: Transform,
+    blur: Option<Vec<Rectangle<i32, Logical>>>,
+    padding: Option<[i32; 4]>,
+    radii: Option<[u8; 4]>,
+    /// Whether it had subsurfaces, which aren't kept.
+    has_children: bool,
+    /// When the frame after it came.
+    replaced: Instant,
+}
+
+#[derive(Default)]
+struct LastShown(Mutex<Option<Shown>>);
+
+/// A frame this recent before a surface closes is its last one.
+const LAST_FRAME: Duration = Duration::from_millis(50);
+
+/// Called as `surface` commits: keeps what it shows if a new frame replaces it.
+fn keep_shown(surface: &WlSurface) {
+    let new_frame = with_states(surface, |states| {
+        matches!(
+            states.cached_state.get::<SurfaceAttributes>().pending().buffer,
+            Some(BufferAssignment::NewBuffer(_))
+        )
+    });
+    if !new_frame {
+        return;
+    }
+    let current = with_renderer_surface_state(surface, |state| {
+        let dmabuf = get_dmabuf(state.buffer()?).ok()?.clone();
+        Some((dmabuf, state.view()?, state.buffer_scale(), state.buffer_transform()))
+    })
+    .flatten();
+    let has_children = !get_children(surface).is_empty();
+    with_states(surface, |states| {
+        let shown = current.map(|(dmabuf, view, buffer_scale, transform)| Shown {
+            dmabuf,
+            src: view.src,
+            dst: view.dst,
+            offset: view.offset,
+            buffer_scale,
+            transform,
+            blur: states
+                .cached_state
+                .get::<ComputedBlurRegionCachedState>()
+                .current()
+                .blur_region
+                .clone(),
+            padding: surface_padding(states),
+            radii: surface_corners(states, view.dst),
+            has_children,
+            replaced: Instant::now(),
+        });
+        *states
+            .data_map
+            .get_or_insert_threadsafe(LastShown::default)
+            .0
+            .lock()
+            .unwrap() = shown;
+    });
+}
+
+/// What `surface` showed before a frame it drew right as it closed, if it did.
+fn shown_before_closing(surface: &WlSurface) -> Option<Shown> {
+    with_states(surface, |states| {
+        states
+            .data_map
+            .get::<LastShown>()?
+            .0
+            .lock()
+            .unwrap()
+            .take()
+            .filter(|shown| shown.replaced.elapsed() < LAST_FRAME)
+    })
+}
+
+/// Called as a layer surface maps.
+pub fn layer_mapped(layer: &LayerSurface) {
+    if let Some(animation) = for_namespace(layer.namespace()) {
+        mark(layer.wl_surface(), animation);
+    }
+}
+
+/// Called as a popup of a layer surface is made.
+pub fn popup_created(surface: &WlSurface) {
+    mark(surface, POPUP);
+}
+
+/// How far opening `surface` is, eased, if it is.
+fn opening_progress(surface: &WlSurface) -> Option<(Animation, f64)> {
+    let frame = with_renderer_surface_state(surface, |state| {
+        state.buffer().is_some().then(|| state.current_commit())
+    })
+    .flatten();
+    with_states(surface, |states| {
+        let opening = states.data_map.get::<Opening>()?;
+        let now = Instant::now();
+        let mut clock = opening.clock.lock().unwrap();
+        let start = match (clock.start, clock.first, frame) {
+            (Some(start), _, _) => start,
+            (None, None, None) => return None,
+            (None, None, Some(frame)) => {
+                clock.first = Some((frame, now));
+                return Some((opening.animation, 0.0));
+            }
+            (None, Some((first, at)), frame)
+                if frame.is_some_and(|frame| frame != first)
+                    || now.duration_since(at) >= SECOND_FRAME_WAIT =>
+            {
+                *clock.start.insert(now)
+            }
+            (None, Some(_), _) => return Some((opening.animation, 0.0)),
+        };
+        let linear =
+            now.duration_since(start).as_secs_f64() / opening.animation.open.as_secs_f64();
+        (linear < 1.0).then(|| (opening.animation, EaseOutQuad.y(linear)))
+    })
+}
+
+/// For drawing `surface`, whose visible part is `area`: its alpha, and the
+/// scale to draw it at around a point, while it opens.
+pub fn opening(
+    surface: &WlSurface,
+    area: Rectangle<f64, Logical>,
+    from_above: bool,
+) -> Option<(f32, f64, Point<f64, Logical>)> {
+    let (mut animation, progress) = opening_progress(surface)?;
+    if animation == POPUP && !from_above {
+        animation.origin.1 = 1.0;
+    }
+    let scale = animation.scale + (1.0 - animation.scale) * progress;
+    Some((progress as f32, scale, origin(&animation, area)))
+}
+
+fn origin(animation: &Animation, area: Rectangle<f64, Logical>) -> Point<f64, Logical> {
+    area.loc + Point::from((area.size.w * animation.origin.0, area.size.h * animation.origin.1))
+}
+
+fn overview_layers(output: &Output) -> Vec<LayerSurface> {
+    layer_map_for_output(output)
+        .layers()
+        .filter(|s| s.namespace() == WORKSPACE_OVERVIEW_NAMESPACE)
+        .cloned()
+        .collect()
+}
+
+/// Whether the overview is still opening on `output`: the windows are drawn,
+/// fading out, until it's done.
+pub fn overview_opening(output: &Output) -> bool {
+    overview_layers(output)
+        .iter()
+        .any(|layer| opening_progress(layer.wl_surface()).is_some())
+}
+
+/// The windows fade out as the overview opens, and back in as it closes.
+pub fn windows_alpha(output: &Output) -> f32 {
+    let opening = overview_layers(output)
+        .iter()
+        .filter_map(|layer| opening_progress(layer.wl_surface()))
+        .map(|(_, progress)| 1.0 - progress as f32)
+        .reduce(f32::min);
+    if let Some(alpha) = opening {
+        return alpha;
+    }
+    closing_layers(output)
+        .lock()
+        .unwrap()
+        .iter()
+        .filter(|closing| closing.animation == OVERVIEW)
+        .map(|closing| closing.progress() as f32)
+        .reduce(f32::min)
+        .unwrap_or(1.0)
+}
+
+/// Whether anything opens or closes on `output`.
+pub fn animating(output: &Output) -> bool {
+    if !closing_layers(output).lock().unwrap().is_empty() {
+        return true;
+    }
+    let layers = layer_map_for_output(output)
+        .layers()
+        .cloned()
+        .collect::<Vec<_>>();
+    layers.iter().any(|layer| {
+        opening_progress(layer.wl_surface()).is_some()
+            || PopupManager::popups_for_surface(layer.wl_surface())
+                .any(|(popup, _)| opening_progress(popup.wl_surface()).is_some())
+    })
+}
+
+/// Drops what's done closing; whether anything was.
+pub fn update(output: &Output) -> bool {
+    let mut closing = closing_layers(output).lock().unwrap();
+    let before = closing.len();
+    closing.retain(|closing| closing.progress() < 1.0);
+    closing.len() != before
+}
+
+#[derive(Default)]
+struct ClosingLayers(Mutex<Vec<ClosingLayer>>);
+
+fn closing_layers(output: &Output) -> &Mutex<Vec<ClosingLayer>> {
+    &output
+        .user_data()
+        .get_or_insert_threadsafe(ClosingLayers::default)
+        .0
+}
+
+#[derive(Debug)]
+pub struct ClosingLayer {
+    buffer: MemoryRenderBuffer,
+    /// Where the picture was on the output.
+    area: Rectangle<i32, Logical>,
+    /// The picture's size in pixels.
+    pixels: Size<i32, Logical>,
+    animation: Animation,
+    origin: Point<f64, Logical>,
+    start: Instant,
+    blur: Option<ClosingBlur>,
+}
+
+/// The blur behind a surface, kept as it closes: the picture can't have it,
+/// it's of what's behind.
+#[derive(Debug)]
+pub struct ClosingBlur {
+    state: Mutex<BlurState>,
+    /// Where it was on the output.
+    geometry: Rectangle<f64, Logical>,
+    /// What of that is blurred.
+    region: Vec<Rectangle<i32, Logical>>,
+    radii: [u8; 4],
+}
+
+impl ClosingBlur {
+    /// The blur behind what `shown` showed, if any, blurring `geometry` on the output.
+    fn from_shown(shown: &Shown, geometry: Rectangle<i32, Logical>) -> Option<Self> {
+        Some(ClosingBlur {
+            state: Mutex::new(BlurState::default()),
+            geometry: geometry.to_f64(),
+            region: shown.blur.clone()?,
+            radii: shown.radii.unwrap_or([0; 4]),
+        })
+    }
+
+    /// The blur behind `surface`, if it has any, blurring `geometry` on the output.
+    pub fn of(surface: &WlSurface, geometry: Rectangle<i32, Logical>) -> Option<Self> {
+        with_states(surface, |states| {
+            let region = states
+                .cached_state
+                .get::<ComputedBlurRegionCachedState>()
+                .current()
+                .blur_region
+                .clone()?;
+            Some(ClosingBlur {
+                state: Mutex::new(BlurState::default()),
+                geometry: geometry.to_f64(),
+                region,
+                radii: surface_corners(states, geometry.size).unwrap_or([0; 4]),
+            })
+        })
+    }
+
+    /// The blur, at `scale` around `origin` and fading to `alpha`.
+    pub fn element<R>(
+        &self,
+        renderer: &mut R,
+        origin: Point<f64, Logical>,
+        scale: f64,
+        alpha: f32,
+        output_scale: f64,
+        strength: usize,
+    ) -> Option<BlurElement>
+    where
+        R: AsGlowRenderer + smithay::backend::renderer::ImportAll,
+    {
+        let geometry = Rectangle::new(
+            origin + (self.geometry.loc - origin).upscale(scale),
+            self.geometry.size.upscale(scale),
+        );
+        let region = self
+            .region
+            .iter()
+            .map(|rect| {
+                Rectangle::new(
+                    rect.loc.to_f64().upscale(scale).to_i32_round(),
+                    rect.size.to_f64().upscale(scale).to_i32_round(),
+                )
+            })
+            .collect();
+        let radii = self.radii.map(|r| (r as f64 * scale).round() as u8);
+        BlurElement::internal(
+            renderer,
+            &mut self.state.lock().unwrap(),
+            geometry,
+            &region,
+            output_scale,
+            radii,
+            strength,
+            alpha,
+        )
+        .ok()
+        .flatten()
+    }
+}
+
+impl ClosingLayer {
+    fn progress(&self) -> f64 {
+        (Instant::now().duration_since(self.start).as_secs_f64()
+            / self.animation.close.as_secs_f64())
+        .min(1.0)
+    }
+
+    fn render_element<R>(
+        &self,
+        renderer: &mut R,
+        output_scale: f64,
+    ) -> Option<MemoryRenderBufferRenderElement<R>>
+    where
+        R: AsGlowRenderer,
+        R::TextureId: Send + Clone + 'static,
+    {
+        let progress = EaseOutQuad.y(self.progress());
+        let scale = 1.0 + (self.animation.scale - 1.0) * progress;
+        let area = self.area.to_f64();
+        let size = area.size.upscale(scale);
+        let loc = self.origin + (area.loc - self.origin).upscale(scale);
+
+        MemoryRenderBufferRenderElement::from_buffer(
+            renderer,
+            loc.to_physical(output_scale),
+            &self.buffer,
+            Some((1.0 - progress) as f32),
+            Some(Rectangle::from_size(self.pixels.to_f64())),
+            Some(size.to_i32_round()),
+            Kind::Unspecified,
+        )
+        .ok()
+    }
+}
+
+/// The closing surfaces on `output`, topmost first, each over its blur.
+pub fn closing_elements<R>(
+    renderer: &mut R,
+    output: &Output,
+    blur_strength: usize,
+) -> Vec<WorkspaceRenderElement<R>>
+where
+    R: AsGlowRenderer + smithay::backend::renderer::ImportAll,
+    R::TextureId: Send + Clone + 'static,
+{
+    let scale = output.current_scale().fractional_scale();
+    let mut elements = Vec::new();
+    for closing in closing_layers(output).lock().unwrap().iter().rev() {
+        if let Some(elem) = closing.render_element(renderer, scale) {
+            elements.push(WorkspaceRenderElement::Window(
+                CosmicMappedRenderElement::from(IcedRenderElement::UI(elem)),
+            ));
+        }
+        if let Some(blur) = &closing.blur {
+            let progress = EaseOutQuad.y(closing.progress());
+            let by = 1.0 + (closing.animation.scale - 1.0) * progress;
+            if let Some(elem) = blur.element(
+                renderer,
+                closing.origin,
+                by,
+                (1.0 - progress) as f32,
+                scale,
+                blur_strength,
+            ) {
+                elements.push(WorkspaceRenderElement::OverrideRedirect(
+                    SurfaceRenderElement::Blur(elem),
+                ));
+            }
+        }
+    }
+    elements
+}
+
+/// A picture of the surface tree of `surface`, whose origin is at `loc` and
+/// whose geometry is `geometry`, of `area` (all on the output) at `scale`.
+fn picture<R>(
+    renderer: &mut R,
+    surface: &WlSurface,
+    loc: Point<i32, Logical>,
+    geometry: Rectangle<i32, Logical>,
+    area: Rectangle<i32, Logical>,
+    scale: f64,
+) -> anyhow::Result<(MemoryRenderBuffer, Size<i32, Logical>)>
+where
+    R: AsGlowRenderer,
+    R::TextureId: Send + Clone + 'static,
+    R::Error: Send + Sync + 'static,
+    SurfaceRenderElement<R>: RenderElement<R>,
+{
+    let size = area.size.to_physical_precise_round(scale);
+    anyhow::ensure!(size.w > 0 && size.h > 0, "nothing to picture");
+
+    let radii = with_states(surface, |states| surface_corners(states, geometry.size))
+        .unwrap_or([0; 4]);
+    let mut elements = Vec::new();
+    push_render_elements_from_surface_tree(
+        renderer,
+        surface,
+        (loc - area.loc).to_physical_precise_round(scale),
+        Rectangle::new(geometry.loc - area.loc, geometry.size).to_f64(),
+        Scale::from(scale),
+        1.0,
+        false,
+        radii,
+        None,
+        0,
+        FRAME_TIME_FILTER,
+        &mut |elem| elements.push(elem),
+        None,
+    );
+    anyhow::ensure!(!elements.is_empty(), "nothing to picture");
+    render_picture(renderer, size, scale, &elements)
+}
+
+/// A picture of what `shown` showed, at `loc` in `area` (on the output) at `scale`.
+fn picture_shown<R>(
+    renderer: &mut R,
+    shown: &Shown,
+    loc: Point<i32, Logical>,
+    area: Rectangle<i32, Logical>,
+    scale: f64,
+) -> anyhow::Result<(MemoryRenderBuffer, Size<i32, Logical>)>
+where
+    R: AsGlowRenderer + ImportDma,
+    R::TextureId: Texture + Send + Clone + 'static,
+    R::Error: Send + Sync + 'static,
+    TextureRenderElement<R::TextureId>: RenderElement<R>,
+{
+    let size = area.size.to_physical_precise_round(scale);
+    anyhow::ensure!(size.w > 0 && size.h > 0, "nothing to picture");
+    let texture = renderer.import_dmabuf(&shown.dmabuf, None)?;
+    let element = TextureRenderElement::from_static_texture(
+        Id::new(),
+        renderer.context_id(),
+        (loc + shown.offset - area.loc).to_f64().to_physical(scale),
+        texture,
+        shown.buffer_scale,
+        shown.transform,
+        None,
+        Some(shown.src),
+        Some(shown.dst),
+        None,
+        Kind::Unspecified,
+    );
+    render_picture(renderer, size, scale, &[element])
+}
+
+/// Draws `elements` into a picture of `size` pixels, laid out at `scale`.
+fn render_picture<R, E>(
+    renderer: &mut R,
+    size: Size<i32, smithay::utils::Physical>,
+    scale: f64,
+    elements: &[E],
+) -> anyhow::Result<(MemoryRenderBuffer, Size<i32, Logical>)>
+where
+    R: AsGlowRenderer,
+    R::Error: Send + Sync + 'static,
+    E: RenderElement<R>,
+{
+    let format = Fourcc::Abgr8888;
+    let buffer_size = size.to_logical(1).to_buffer(1, Transform::Normal);
+    let mut render_buffer =
+        Offscreen::<GlesRenderbuffer>::create_buffer(renderer, format, buffer_size)?;
+    let mut fb = renderer.bind(&mut render_buffer)?;
+    // at the scale the elements were laid out at, or they come out that much
+    // smaller (or bigger), from the top left
+    let mut damage_tracker = OutputDamageTracker::new(size, scale, Transform::Normal);
+    damage_tracker
+        .render_output(renderer, &mut fb, 0, elements, [0.0, 0.0, 0.0, 0.0])
+        .map_err(|err| match err {
+            smithay::backend::renderer::damage::Error::Rendering(err) => err,
+            smithay::backend::renderer::damage::Error::OutputNoMode(_) => unreachable!(),
+        })?;
+    let mapping = renderer.copy_framebuffer(&fb, Rectangle::from_size(buffer_size), format)?;
+    let pixels = renderer.map_texture(&mapping)?;
+    let buffer =
+        MemoryRenderBuffer::from_slice(pixels, format, buffer_size, 1, Transform::Normal, None);
+    Ok((buffer, size.to_logical(1)))
+}
+
+struct Target {
+    surface: WlSurface,
+    /// What it showed before its last frame, to picture instead.
+    shown: Option<Shown>,
+    output: Output,
+    loc: Point<i32, Logical>,
+    geometry: Rectangle<i32, Logical>,
+    area: Rectangle<i32, Logical>,
+    animation: Animation,
+    origin: Point<f64, Logical>,
+    blur: Option<ClosingBlur>,
+}
+
+fn keep_picture(state: &mut State, target: Target) {
+    let scale = target.output.current_scale().fractional_scale();
+    let dh = state.common.display_handle.clone();
+    let picture = state
+        .backend
+        .offscreen_renderer(|kms| {
+            advertised_node_for_surface(&target.surface, &dh)
+                .or(*kms.primary_node.read().unwrap())
+        })
+        .context("No renderer to picture the closing surface")
+        .and_then(|renderer| match (renderer, &target.shown) {
+            (RendererRef::Glow(renderer), Some(shown)) => {
+                picture_shown(renderer, shown, target.loc, target.area, scale)
+            }
+            (RendererRef::GlMulti(mut renderer), Some(shown)) => {
+                picture_shown(&mut renderer, shown, target.loc, target.area, scale)
+            }
+            (RendererRef::Glow(renderer), None) => picture(
+                renderer,
+                &target.surface,
+                target.loc,
+                target.geometry,
+                target.area,
+                scale,
+            ),
+            (RendererRef::GlMulti(mut renderer), None) => picture(
+                &mut renderer,
+                &target.surface,
+                target.loc,
+                target.geometry,
+                target.area,
+                scale,
+            ),
+        });
+
+    match picture {
+        Ok((buffer, pixels)) => {
+            closing_layers(&target.output)
+                .lock()
+                .unwrap()
+                .push(ClosingLayer {
+                    buffer,
+                    area: target.area,
+                    pixels,
+                    animation: target.animation,
+                    origin: target.origin,
+                    start: Instant::now(),
+                    blur: target.blur,
+                });
+            state.backend.schedule_render(&target.output);
+        }
+        Err(err) => warn!(?err, "Failed to picture the closing surface"),
+    }
+}
+
+/// Keeps a picture of `layer` on `output` to close, if it animates; called
+/// right before unmapping it.
+pub fn picture_closing_layer(state: &mut State, output: &Output, layer: &LayerSurface) {
+    let Some(animation) = for_namespace(layer.namespace()) else {
+        return;
+    };
+    // Only one that was showing.
+    if !with_renderer_surface_state(layer.wl_surface(), |state| state.buffer().is_some())
+        .unwrap_or(false)
+    {
+        return;
+    }
+    let Some(layer_geometry) = layer_map_for_output(output).layer_geometry(layer) else {
+        return;
+    };
+    let loc = layer_geometry.loc;
+    let mut geometry = layer.geometry();
+    geometry.loc += loc;
+    let before = shown_before_closing(layer.wl_surface());
+    let padding = match &before {
+        Some(before) => before.padding,
+        None => with_states(layer.wl_surface(), surface_padding),
+    };
+    let shown = padding
+        .and_then(|padding| pad_rect(geometry, &padding))
+        .unwrap_or(geometry);
+    let area = if shown == geometry {
+        geometry
+    } else {
+        let mut area = shown;
+        area.loc -= Point::from((PICTURE_MARGIN, PICTURE_MARGIN));
+        area.size += Size::from((PICTURE_MARGIN * 2, PICTURE_MARGIN * 2));
+        area.intersection(geometry).unwrap_or(shown)
+    };
+
+    let blur = match &before {
+        Some(before) => ClosingBlur::from_shown(before, shown),
+        None => ClosingBlur::of(layer.wl_surface(), shown),
+    };
+    keep_picture(
+        state,
+        Target {
+            surface: layer.wl_surface().clone(),
+            // its subsurfaces go with the last frame
+            shown: before.filter(|before| !before.has_children),
+            output: output.clone(),
+            loc,
+            geometry,
+            area,
+            animation,
+            origin: origin(&animation, shown.to_f64()),
+            blur,
+        },
+    );
+}
+
+/// Keeps a picture of the popup `surface` to close, if it's of a layer
+/// surface; called as it's destroyed.
+pub fn picture_closing_popup(state: &mut State, surface: &WlSurface) {
+    let found = {
+        let shell = state.common.shell.read();
+        shell.outputs().find_map(|output| {
+            let map = layer_map_for_output(output);
+            map.layers().find_map(|layer| {
+                let layer_geometry = map.layer_geometry(layer)?;
+                PopupManager::popups_for_surface(layer.wl_surface()).find_map(
+                    |(popup, offset)| {
+                        (popup.wl_surface() == surface).then(|| {
+                            let loc = layer_geometry.loc + offset - popup.geometry().loc;
+                            let mut geometry = popup.geometry();
+                            geometry.loc += loc;
+                            let below = geometry.loc.y as f64 + geometry.size.h as f64 / 2.0
+                                >= layer_geometry.loc.y as f64
+                                    + layer_geometry.size.h as f64 / 2.0;
+                            (output.clone(), loc, geometry, below)
+                        })
+                    },
+                )
+            })
+        })
+    };
+    let Some((output, loc, geometry, below)) = found else {
+        return;
+    };
+    if !with_renderer_surface_state(surface, |state| state.buffer().is_some()).unwrap_or(false) {
+        return;
+    }
+    let mut animation = POPUP;
+    if !below {
+        animation.origin.1 = 1.0;
+    }
+    let before = shown_before_closing(surface);
+    let blur = match &before {
+        Some(before) => ClosingBlur::from_shown(before, geometry),
+        None => ClosingBlur::of(surface, geometry),
+    };
+    keep_picture(
+        state,
+        Target {
+            surface: surface.clone(),
+            shown: before.filter(|before| !before.has_children),
+            output,
+            loc,
+            geometry,
+            area: geometry,
+            animation,
+            origin: origin(&animation, geometry.to_f64()),
+            blur,
+        },
+    );
+}
+
+/// Whether the popup at `geometry` is below the layer surface it's of, on
+/// `output`: it grows down from it then, else up.
+pub fn popup_below(output: &Output, layer: &LayerSurface, geometry: Rectangle<i32, Logical>) -> bool {
+    let Some(layer_geometry) = layer_map_for_output(output).layer_geometry(layer) else {
+        return true;
+    };
+    geometry.loc.y as f64 + geometry.size.h as f64 / 2.0
+        >= layer_geometry.loc.y as f64 + layer_geometry.size.h as f64 / 2.0
+}
