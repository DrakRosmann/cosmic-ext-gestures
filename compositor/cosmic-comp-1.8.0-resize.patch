+//! Windows changing size, as when maximized, like GNOME's: a picture of the
+//! window is taken before its client hears of the new size, and shown in its
+//! place until the client has drawn itself at that size. Then the window
+//! grows (or shrinks) from the old size to the new one, under the picture,
+//! stretched along and fading out.
+//!
+//! COSMIC's apps are see-through and blurred, unless maximized: the picture
+//! keeps the blur behind it, so that fades out too instead of going at once.
+
+use anyhow::Context;
+use smithay::{
+    backend::renderer::element::{
+        Kind, RenderElement,
+        memory::{MemoryRenderBuffer, MemoryRenderBufferRenderElement},
+    },
+    desktop::space::SpaceElement,
+    output::Output,
+    utils::{Logical, Point, Rectangle, Size},
+    wayland::seat::WaylandFocus,
+};
+use tracing::{debug, warn};
+
+use crate::{
+    backend::render::{RendererRef, element::AsGlowRenderer, wayland::SurfaceRenderElement},
+    shell::{
+        close_animation::picture_mapped,
+        element::{CosmicMapped, CosmicMappedRenderElement, window::CosmicWindowRenderElement},
+        layer_animation::ClosingBlur,
+    },
+    state::{State, advertised_node_for_surface},
+    utils::iced::IcedRenderElement,
+};
+
+#[derive(Debug)]
+pub struct ResizePicture {
+    buffer: MemoryRenderBuffer,
+    /// What's pictured, from the window's origin: the window and what its
+    /// client draws around it.
+    area: Rectangle<i32, Logical>,
+    /// The picture's size in pixels.
+    pixels: Size<i32, Logical>,
+    /// The window's size then.
+    size: Size<i32, Logical>,
+    blur: Option<ClosingBlur>,
+}
+
+impl ResizePicture {
+    fn new<R>(renderer: &mut R, mapped: &CosmicMapped, scale: f64) -> anyhow::Result<Self>
+    where
+        R: AsGlowRenderer,
+        R::TextureId: Send + Clone + 'static,
+        R::Error: Send + Sync + 'static,
+        CosmicMappedRenderElement<R>: RenderElement<R>,
+    {
+        let (buffer, bbox, pixels) = picture_mapped(renderer, mapped, scale)?;
+        let geometry = mapped.geometry();
+        let blur = mapped
+            .active_window()
+            .wl_surface()
+            .and_then(|surface| ClosingBlur::of(&surface, Rectangle::from_size(geometry.size)));
+        Ok(ResizePicture {
+            buffer,
+            area: Rectangle::new(bbox.loc - geometry.loc, bbox.size),
+            pixels,
+            size: geometry.size,
+            blur,
+        })
+    }
+
+    /// The picture over the window at `window`, with the blur it had under
+    /// it: topmost first.
+    pub fn push_render_elements<R>(
+        &self,
+        renderer: &mut R,
+        window: Rectangle<f64, Logical>,
+        output_scale: f64,
+        alpha: f32,
+        blur_strength: usize,
+        push: &mut dyn FnMut(CosmicMappedRenderElement<R>),
+    ) where
+        R: AsGlowRenderer,
+        R::TextureId: Send + Clone + 'static,
+        CosmicMappedRenderElement<R>: RenderElement<R>,
+    {
+        if alpha <= 0.0 {
+            return;
+        }
+        let x = window.size.w / self.size.w.max(1) as f64;
+        let y = window.size.h / self.size.h.max(1) as f64;
+        let loc = window.loc
+            + Point::from((self.area.loc.x as f64 * x, self.area.loc.y as f64 * y));
+        let size = Size::<f64, Logical>::from((
+            self.area.size.w as f64 * x,
+            self.area.size.h as f64 * y,
+        ));
+        if let Ok(elem) = MemoryRenderBufferRenderElement::from_buffer(
+            renderer,
+            loc.to_physical(output_scale),
+            &self.buffer,
+            Some(alpha),
+            // all of it, stretched to `size`
+            Some(Rectangle::from_size(self.pixels.to_f64())),
+            Some(size.to_i32_round()),
+            Kind::Unspecified,
+        ) {
+            push(IcedRenderElement::UI(elem).into());
+        }
+        if let Some(blur) = self.blur.as_ref().filter(|_| blur_strength > 0)
+            && let Some(elem) = blur.element_in(renderer, window, alpha, output_scale, blur_strength)
+        {
+            push(CosmicMappedRenderElement::Window(
+                CosmicWindowRenderElement::Window(SurfaceRenderElement::Blur(elem)),
+            ));
+        }
+    }
+}
+
+/// Takes the pictures windows about to change size want, of how they look
+/// now. Called before the clients are sent what happened, so they haven't
+/// drawn themselves anew yet.
+pub fn picture_resizing_windows(state: &mut State) {
+    let wanted: Vec<(CosmicMapped, Output)> = {
+        let shell = state.common.shell.read();
+        let mut wanted = Vec::new();
+        for set in shell.workspaces.sets.values() {
+            for mapped in set.sticky_layer.wanting_pictures() {
+                wanted.push((mapped, set.output.clone()));
+            }
+            for workspace in &set.workspaces {
+                for mapped in workspace.floating_layer.wanting_pictures() {
+                    wanted.push((mapped, workspace.output.clone()));
+                }
+            }
+        }
+        wanted
+    };
+    if wanted.is_empty() {
+        return;
+    }
+
+    let dh = state.common.display_handle.clone();
+    let mut pictures = Vec::with_capacity(wanted.len());
+    for (mapped, output) in wanted {
+        let visible = {
+            let shell = state.common.shell.read();
+            shell.workspaces.sets.get(&output).is_some_and(|set| {
+                set.sticky_layer.mapped().any(|m| m == &mapped)
+                    || shell
+                        .active_space(&output)
+                        .is_some_and(|workspace| workspace.floating_layer.mapped().any(|m| m == &mapped))
+            })
+        };
+        let picture = if visible {
+            let start = std::time::Instant::now();
+            let scale = output.current_scale().fractional_scale();
+            let surface = mapped.active_window().wl_surface().map(|s| s.into_owned());
+            state
+                .backend
+                .offscreen_renderer(|kms| {
+                    surface
+                        .as_ref()
+                        .and_then(|surface| advertised_node_for_surface(surface, &dh))
+                        .or(*kms.primary_node.read().unwrap())
+                })
+                .context("No renderer to picture the window")
+                .and_then(|renderer| match renderer {
+                    RendererRef::Glow(renderer) => ResizePicture::new(renderer, &mapped, scale),
+                    RendererRef::GlMulti(mut renderer) => {
+                        ResizePicture::new(&mut renderer, &mapped, scale)
+                    }
+                })
+                .inspect(|_| debug!(took = ?start.elapsed(), "Pictured a window changing size"))
+                .map_err(|err| warn!(?err, "Failed to picture the window"))
+                .ok()
+        } else {
+            None
+        };
+        pictures.push((mapped, picture));
+    }
+
+    let mut shell = state.common.shell.write();
+    for (mapped, picture) in pictures {
+        let mut picture = Some(picture);
+        for set in shell.workspaces.sets.values_mut() {
+            let layers = std::iter::once(&mut set.sticky_layer).chain(
+                set.workspaces
+                    .iter_mut()
+                    .map(|workspace| &mut workspace.floating_layer),
+            );
+            for layer in layers {
+                if let Some(taken) = picture.take() {
+                    picture = layer.set_picture(&mapped, taken);
+                }
+            }
+        }
+    }
+}
